# Anthropic API key — used by the Brain dispatcher and morning briefing scheduler
ANTHROPIC_API_KEY=sk-ant-...

# Base URL of the claude-dash dashboard API
DASHBOARD_URL=https://dash.2by4llc.com

# Password sent as x-dash-password header to authenticate dashboard API requests
DASH_PASSWORD=your-dash-password-here

# Meta Ads API access token — used by the creative analyst agent
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxx

# Port the Brain server listens on (optional, defaults to 3001)
PORT=3001
